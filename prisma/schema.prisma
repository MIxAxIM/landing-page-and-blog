// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  // provider     = "mysql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Possible todo:
// - add Comment model for Lesson and/or Assignment

// Necessary for Next auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  learner Learner?
  creator Creator?

  userWallet           UserWallet?
  unconfirmedTx        String?
  accessTokenMintTx    String?
  hasMintedAccessToken Boolean     @default(false)
  nostrNsec            String?
  nostrPubkey          String?

  tncVersion String?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Slt {
  id          String @id @default(cuid())
  moduleIndex Int

  moduleId String
  module   Module @relation("ModuleSLTs", fields: [moduleId], references: [id])

  sltText String

  lesson Lesson?

  assignments Assignment[] @relation("AssignmentSLTs")

  createdBy   Creator @relation("CreatedSLTs", fields: [createdById], references: [id])
  createdById String

  variants SltVariant[] @relation("SltVariants")

  @@index([moduleId, moduleIndex])
  @@index([createdById])
  @@index([id])
}

model SltVariant {
  id String @id @default(cuid())

  sltText String

  // lessonVariant LessonVariant?

  sltId           String
  slt             Slt           @relation("SltVariants", fields: [sltId], references: [id])
  moduleVariantId String
  moduleVariant   ModuleVariant @relation("SltVariantsModuleVariant", fields: [moduleVariantId], references: [id])

  @@index([moduleVariantId])
  @@index([sltId])
  @@index([id])
}

model Module {
  id         String  @id @default(cuid())
  moduleCode String
  moduleHash String?

  title       String
  description String?
  imageUrl    String?
  videoUrl    String?
  live        Boolean?
  releaseDate DateTime?

  courseId       String
  originalCourse Course @relation("CourseModules", fields: [courseId], references: [id])
  // Feature: Add copiedToCourses Course[] for re-use of Modules in different courses.

  slts        Slt[]        @relation("ModuleSLTs")
  lessons     Lesson[]     @relation("ModuleLessons")
  assignments Assignment[] @relation("ModuleAssignments")

  introduction Introduction?

  variants ModuleVariant[] @relation("ModuleVariants")

  @@unique([courseId, moduleCode])
  @@index([courseId])
  @@index([id])
}

model ModuleVariant {
  id String @id @default(cuid())

  title       String
  description String?
  imageUrl    String?
  videoUrl    String?

  moduleId        String
  module          Module        @relation("ModuleVariants", fields: [moduleId], references: [id])
  courseVariantId String
  courseVariant   CourseVariant @relation("ModuleVariantsCourseVariant", fields: [courseVariantId], references: [id])

  sltVariants SltVariant[] @relation("SltVariantsModuleVariant")

  @@index([courseVariantId])
  @@index([moduleId])
  @@index([id])
}

enum AccessTier {
  FREE
  PREMIUM
  NETWORK
  HIDDEN
  FEATURED
}

model Course {
  id         String @id @default(cuid())
  courseCode String

  createdBy   Creator @relation("CreatedCourses", fields: [createdById], references: [id])
  createdById String

  title       String
  description String?
  category    String?
  imageUrl    String?
  videoUrl    String?
  live        Boolean?

  modules Module[] @relation("CourseModules")

  contributors       Creator[] @relation("CourseContributors")
  interestedLearners Learner[] @relation("LearnerCourses")

  variants        CourseVariant[]         @relation("CourseVariants")
  onchainInstance CourseOnChainInstance[] @relation("CourseInstance")

  accessTier AccessTier?

  @@unique([courseCode])
  @@index([createdById])
  @@index([id])
}

model CourseVariant {
  id          String @id @default(cuid())
  variantCode String

  title       String
  description String?
  imageUrl    String?
  videoUrl    String?

  courseId       String
  course         Course          @relation("CourseVariants", fields: [courseId], references: [id])
  moduleVariants ModuleVariant[] @relation("ModuleVariantsCourseVariant")
  // contentVariants ContentVariant[] @relation("ContentVariantsCourseVariant")

  @@index([courseId])
  @@index([id])
}

enum Network {
  PREPROD
  MAINNET
  SANCHONET
}

model CourseOnChainInstance {
  id String @id @default(cuid())

  network Network @default(PREPROD)

  course     Course @relation("CourseInstance", fields: [courseCode], references: [courseCode])
  courseCode String

  LocalStateValidatorAddress String?
  CourseCreatorNFTPolicyID   String
  LocalStatePolicyID         String?
  CourseInstanceUTxO         String?
  LocalStatePolicyRefUTxO    String?
  AssignmentValidatorAddress String?
  ModuleValidatorAddress     String?

  @@index([courseCode])
}

model Lesson {
  id String @id @default(cuid())

  title       String?
  description String?
  contentJson Json?
  imageUrl    String?
  videoUrl    String?
  live        Boolean?

  sltId String
  slt   Slt    @relation(fields: [sltId], references: [id])

  moduleId String
  module   Module @relation("ModuleLessons", fields: [moduleId], references: [id])

  // variants ContentVariant[] @relation("ContentsVariants")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Creator  @relation("CreatedLessons", fields: [createdById], references: [id])
  createdById String

  learners Learner[] @relation("LearnerLessons")

  @@unique([sltId])
  @@index([createdById])
  @@index([moduleId])
  @@index([sltId])
  @@index([id])
}

model Assignment {
  id             String  @id @default(cuid())
  assignmentCode String // temporary to start - todo - think about on-chain connection
  assignmentHash String?

  title       String
  description String?
  contentJson Json?
  imageUrl    String?
  videoUrl    String?
  live        Boolean?

  slts Slt[] @relation("AssignmentSLTs")

  moduleId String
  module   Module @relation("ModuleAssignments", fields: [moduleId], references: [id])

  // variants ContentVariant[] @relation("ContentsVariants")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   Creator @relation("CreatedAssignments", fields: [createdById], references: [id])
  createdById String

  assignmentCommitments AssignmentCommitment[] @relation("AssignmentCommitments")

  @@unique([moduleId, assignmentCode])
  @@unique([moduleId])
  @@index([createdById])
  @@index([moduleId])
  @@index([id])
}

enum AssignmentStatus {
  SAVE_FOR_LATER
  IN_PROGRESS
  COMPLETE
  COMMITMENT
  NETWORK_READY
  NOT_STARTED
}

model AssignmentCommitment {
  id String @id @default(cuid())

  assignmentId String
  assignment   Assignment @relation("AssignmentCommitments", fields: [assignmentId], references: [id])

  learnerId String
  learner   Learner @relation("LearnerAssignments", fields: [learnerId], references: [id])

  status   AssignmentStatus @default(SAVE_FOR_LATER)
  favorite Boolean          @default(false)
  archived Boolean          @default(false)

  learnerNotes String?

  @@unique([assignmentId, learnerId])
  @@index([assignmentId])
  @@index([learnerId])
  @@index([id])
}

model Introduction {
  id String @id @default(cuid())

  title       String
  description String?
  contentJson Json?
  imageUrl    String?
  videoUrl    String?
  live        Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id])

  @@unique([moduleId])
  @@index([moduleId])
  @@index([id])
}

model Creator {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courses            Course[] @relation("CreatedCourses")
  contributorCourses Course[] @relation("CourseContributors")

  slts        Slt[]        @relation("CreatedSLTs")
  lessons     Lesson[]     @relation("CreatedLessons")
  assignments Assignment[] @relation("CreatedAssignments")
  // lessonVariants LesssonVariant[] @relation("CreatedLessonVariants")

  @@unique([userId])
}

model Learner {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  savedCourses Course[]               @relation("LearnerCourses")
  lessons      Lesson[]               @relation("LearnerLessons")
  assignments  AssignmentCommitment[] @relation("LearnerAssignments")
  // For Learners, Module completion goes on-chain, so we skip adding it here

  @@unique([userId])
}

model UserWallet {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  walletAddress String
  stakeAddress  String

  @@unique([userId])
}

model AndamioAIQueries {
  id        String   @id @default(cuid())
  userId    String
  type      String
  inputs    String   @db.Text
  outputs   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientsDomain {
  id       String @id @default(cuid())
  host     String
  courseId String @unique
}

// ---------------- NEW CONTRIBUTION FEATURES - PREPROD ONLY ---------------------------------

model Treasury {
  treasuryNftPolicyId String @id @unique
  title               String

  // TODO:
  // 1. How to handle "ownership" of a treasury?
  // 2. Should there be some kind of visibility toggle?
  // 3. Do contributorPolicyIds serve a purpose at this level? (e.g. access control, visibility, decision making?)
  // 4. Should we consider an "organization" type?
  // 5. Consider org- or treasury-level acceptance criteria. 
  // * I think there is some interesting governance stuff we can develop here.

  escrows Escrow[] @relation("TreasuryEscrows")

  @@index([treasuryNftPolicyId])
}

model Escrow {
  id                   String   @id @default(cuid())
  title                String?
  escrowNftPolicyId    String   @unique
  contributorPolicyIds String[]
  isSyncedWithNetwork  Boolean  @default(false)

  treasuryId String
  treasury   Treasury @relation("TreasuryEscrows", fields: [treasuryId], references: [treasuryNftPolicyId])

  tasks Task[] @relation("EscrowTasks")

  @@index([treasuryId])
  @@index([id])
  @@index([escrowNftPolicyId])
}

enum TaskStatus {
  DRAFT
  APPROVED
  ON_CHAIN
  COMMITMENT_MADE
  COMPLETE
}

model Task {
  id                 String     @id @default(cuid())
  index              Int
  title              String
  description        String
  acceptanceCriteria String[]
  status             TaskStatus @default(DRAFT)

  lovelace       String
  expirationTime String

  escrowId String
  escrow   Escrow @relation("EscrowTasks", fields: [escrowId], references: [id])

  @@unique([escrowId, index])
  @@index([escrowId])
  @@index([id])
}

// ---------------- END OF NEW CONTRIBUTION FEATURES -----------------------------------------

