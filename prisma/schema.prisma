// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  // provider     = "mysql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Possible todo:
// - add Comment model for Lesson and/or Assignment

// Necessary for Next auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // stripe integrations
  stripeCustomerId         String?
  stripeSubscriptionId     String?
  stripeSubscriptionStatus StripeSubscriptionStatus?
  subscriptions            Subscription[]

  // andamio roles
  roleTypes           RoleType[] // WARNING: check this field in migration
  isAdmin             Boolean              @default(false)
  learner             Learner?
  creator             Creator?
  treasuryOwner       TreasuryOwner?
  contributionManager ContributionManager?
  contributor         Contributor?

  // organization relationships
  memberOrganizations OrganizationMember[] @relation("MemberOrganizations")

  // user status
  tncVersion            String?
  hasMintedAccessToken  Boolean           @default(false)
  onboardingStatus      OnboardingStatus? // WARNING: needs to be initialized for each user in production db
  onboardingStartedAt   DateTime?
  onboardingCompletedAt DateTime?

  userWallet        UserWallet?
  unconfirmedTx     String?
  accessTokenMintTx String?

  // nostr
  nostrNsec   String?
  nostrPubkey String?
}

enum RoleType {
  LEARNER
  CREATOR
  TREASURY_OWNER
  CONTRIUBTION_MANAGER
  CONTRIBUTOR
}

enum OnboardingStatus {
  NOT_STARTED
  SKIPPED
  PARTIAL
  COMPLETE
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  courses    OrganizationCourse[]
  treasuries OrganizationTreasury[]
  members    OrganizationMember[]
}

model OrganizationCourse {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id])
  createdAt      DateTime     @default(now())

  @@id([organizationId, courseId])
  @@index([organizationId])
  @@index([courseId])
}

model OrganizationTreasury {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  treasuryId     String
  treasury       Treasury     @relation(fields: [treasuryId], references: [id])
  createdAt      DateTime     @default(now())

  @@id([organizationId, treasuryId])
  @@index([organizationId])
  @@index([treasuryId])
}

model OrganizationMember {
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String
  user           User             @relation("MemberOrganizations", fields: [userId], references: [id])
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())
  invitedBy      String? // ID of the user who invited this member
  updatedAt      DateTime         @updatedAt

  @@id([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

enum OrganizationRole {
  OWNER // Can do everything, can't be removed
  ADMIN // Can manage members, courses and projects
  MEMBER // Contribution and Decision-Making access, depending on network credentials. Can draft tasks.
  GUEST // View-only access
}

model Slt {
  id          String @id @default(cuid())
  moduleIndex Int

  moduleId String
  module   Module @relation("ModuleSLTs", fields: [moduleId], references: [id])

  sltText String

  lesson Lesson?

  assignments Assignment[] @relation("AssignmentSLTs")

  createdBy   Creator @relation("CreatedSLTs", fields: [createdById], references: [id])
  createdById String

  variants SltVariant[] @relation("SltVariants")

  @@index([moduleId, moduleIndex])
  @@index([createdById])
  @@index([id])
}

model SltVariant {
  id String @id @default(cuid())

  sltText String

  // lessonVariant LessonVariant?

  sltId           String
  slt             Slt           @relation("SltVariants", fields: [sltId], references: [id])
  moduleVariantId String
  moduleVariant   ModuleVariant @relation("SltVariantsModuleVariant", fields: [moduleVariantId], references: [id])

  @@index([moduleVariantId])
  @@index([sltId])
  @@index([id])
}

enum ModuleStatus {
  DRAFT
  APPROVED
  PENDING_TX
  ON_CHAIN
  DEPRECATED
  BACKLOG
  ARCHIVED
}

model Module {
  id         String       @id @default(cuid())
  moduleCode String
  moduleHash String?
  status     ModuleStatus @default(DRAFT)

  title       String
  description String?
  imageUrl    String?
  videoUrl    String?
  live        Boolean?
  releaseDate DateTime?

  courseId       String
  originalCourse Course @relation("CourseModules", fields: [courseId], references: [id])
  // Feature: Add copiedToCourses Course[] for re-use of Modules in different courses.

  slts        Slt[]        @relation("ModuleSLTs")
  lessons     Lesson[]     @relation("ModuleLessons")
  assignments Assignment[] @relation("ModuleAssignments")

  introduction Introduction?

  variants ModuleVariant[] @relation("ModuleVariants")

  @@unique([courseId, moduleCode])
  @@index([courseId])
  @@index([id])
}

model ModuleVariant {
  id String @id @default(cuid())

  title       String
  description String?
  imageUrl    String?
  videoUrl    String?

  moduleId        String
  module          Module        @relation("ModuleVariants", fields: [moduleId], references: [id])
  courseVariantId String
  courseVariant   CourseVariant @relation("ModuleVariantsCourseVariant", fields: [courseVariantId], references: [id])

  sltVariants SltVariant[] @relation("SltVariantsModuleVariant")

  @@index([courseVariantId])
  @@index([moduleId])
  @@index([id])
}

enum AccessTier {
  FREE
  PREMIUM
  NETWORK
  HIDDEN
  FEATURED
}

model Course {
  id                String  @id @default(cuid())
  courseCode        String
  courseNftPolicyId String? @unique

  createdBy   Creator @relation("CreatedCourses", fields: [createdById], references: [id])
  createdById String

  title       String
  description String?
  category    String?
  imageUrl    String?
  videoUrl    String?
  live        Boolean? @default(false)

  modules Module[] @relation("CourseModules")

  contributors       Creator[] @relation("CourseContributors")
  interestedLearners Learner[] @relation("LearnerCourses")

  variants CourseVariant[] @relation("CourseVariants")

  accessTier AccessTier?

  // NEW ---------
  prerequisiteFor CourseRequirement[]  @relation("PrerequisiteCourses")
  organizations   OrganizationCourse[]
  // END NEW -----

  @@unique([courseCode])
  @@index([createdById])
  @@index([id])
  @@index([courseNftPolicyId])
}

model CourseVariant {
  id          String @id @default(cuid())
  variantCode String

  title       String
  description String?
  imageUrl    String?
  videoUrl    String?

  courseId       String
  course         Course          @relation("CourseVariants", fields: [courseId], references: [id])
  moduleVariants ModuleVariant[] @relation("ModuleVariantsCourseVariant")
  // contentVariants ContentVariant[] @relation("ContentVariantsCourseVariant")

  @@index([courseId])
  @@index([id])
}

enum Network {
  PREPROD
  MAINNET
  SANCHONET
}

model Lesson {
  id String @id @default(cuid())

  title       String?
  description String?
  contentJson Json?
  imageUrl    String?
  videoUrl    String?
  live        Boolean?

  sltId String
  slt   Slt    @relation(fields: [sltId], references: [id])

  moduleId String
  module   Module @relation("ModuleLessons", fields: [moduleId], references: [id])

  // variants ContentVariant[] @relation("ContentsVariants")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Creator  @relation("CreatedLessons", fields: [createdById], references: [id])
  createdById String

  learners Learner[] @relation("LearnerLessons")

  @@unique([sltId])
  @@index([createdById])
  @@index([moduleId])
  @@index([sltId])
  @@index([id])
}

model Assignment {
  id             String  @id @default(cuid())
  assignmentCode String // temporary to start - todo - think about on-chain connection
  assignmentHash String?

  title       String
  description String?
  contentJson Json?
  imageUrl    String?
  videoUrl    String?
  live        Boolean?

  slts Slt[] @relation("AssignmentSLTs")

  moduleId String
  module   Module @relation("ModuleAssignments", fields: [moduleId], references: [id])

  // variants ContentVariant[] @relation("ContentsVariants")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   Creator @relation("CreatedAssignments", fields: [createdById], references: [id])
  createdById String

  assignmentCommitments AssignmentCommitment[] @relation("AssignmentCommitments")

  @@unique([moduleId, assignmentCode])
  @@unique([moduleId])
  @@index([createdById])
  @@index([moduleId])
  @@index([id])
}

enum AssignmentPrivateStatus {
  SAVE_FOR_LATER
  IN_PROGRESS
  COMPLETE
  COMMITMENT
  NETWORK_READY
  NOT_STARTED
}

enum AssignmentStatus {
  SAVE_FOR_LATER
  IN_PROGRESS
  COMPLETE
  COMMITMENT
  NETWORK_READY
  NOT_STARTED
}

enum AssignmentNetworkStatus {
  AWAITING_EVIDENCE
  PENDING_TX_COMMITMENT_MADE
  PENDING_TX_ADD_INFO
  PENDING_APPROVAL

  PENDING_TX_ASSIGNMENT_ACCEPTED
  ASSIGNMENT_ACCEPTED

  PENDING_TX_ASSIGNMENT_DENIED
  ASSIGNMENT_DENIED

  PENDING_TX_CLAIM_CREDENTIAL
  CREDENTIAL_CLAIMED

  PENDING_TX_LEAVE_ASSIGNMENT
  ASSIGNMENT_LEFT
}

model AssignmentCommitment {
  id String @id @default(cuid())

  assignmentId String
  assignment   Assignment @relation("AssignmentCommitments", fields: [assignmentId], references: [id])

  learnerId String
  learner   Learner @relation("LearnerAssignments", fields: [learnerId], references: [id])

  privateStatus   AssignmentPrivateStatus @default(SAVE_FOR_LATER)
  privateEvidence Json?

  networkStatus       AssignmentNetworkStatus @default(AWAITING_EVIDENCE)
  networkEvidence     Json?
  networkEvidenceHash String?

  favorite Boolean @default(false)
  archived Boolean @default(false)

  // Deprecated - remove these fields after migration
  learnerNotes String?
  status       AssignmentStatus @default(NOT_STARTED)
  privateNotes String?
  // End Deprecated

  @@unique([assignmentId, learnerId])
  @@index([assignmentId])
  @@index([learnerId])
  @@index([id])
}

model Introduction {
  id String @id @default(cuid())

  title       String
  description String?
  contentJson Json?
  imageUrl    String?
  videoUrl    String?
  live        Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id])

  @@unique([moduleId])
  @@index([moduleId])
  @@index([id])
}

// User Roles

model Creator {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // WARNING - these fields are optional for now to help with db migration. After we are safely migrated to production, manage these fields and make non-nullable if safe.
  isActive  Boolean?  @default(true)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  onboardingStatus      OnboardingStatus? @default(NOT_STARTED)
  onboardingCompletedAt DateTime?

  courses            Course[] @relation("CreatedCourses")
  contributorCourses Course[] @relation("CourseContributors")

  slts        Slt[]        @relation("CreatedSLTs")
  lessons     Lesson[]     @relation("CreatedLessons")
  assignments Assignment[] @relation("CreatedAssignments")
  // lessonVariants LesssonVariant[] @relation("CreatedLessonVariants")

  @@unique([userId])
}

model Learner {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // WARNING - these fields are optional for now to help with db migration. After we are safely migrated to production, manage these fields and make non-nullable if safe.
  isActive  Boolean?  @default(true)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  onboardingStatus      OnboardingStatus? @default(NOT_STARTED)
  onboardingCompletedAt DateTime?

  savedCourses Course[]               @relation("LearnerCourses")
  lessons      Lesson[]               @relation("LearnerLessons")
  assignments  AssignmentCommitment[] @relation("LearnerAssignments")
  // For Learners, Module completion goes on-chain, so we skip adding it here

  @@unique([userId])
}

model TreasuryOwner {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboardingStatus      OnboardingStatus @default(NOT_STARTED)
  onboardingCompletedAt DateTime?

  treasuries Treasury[] @relation("TreasuryOwnerTreasuries")

  @@unique([userId])
}

model ContributionManager {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboardingStatus      OnboardingStatus @default(NOT_STARTED)
  onboardingCompletedAt DateTime?

  treasuries Treasury[] @relation("ContributionManagerTreasuries")

  @@unique([userId])
}

model Contributor {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboardingStatus      OnboardingStatus @default(NOT_STARTED)
  onboardingCompletedAt DateTime?
  Treasury              Treasury[]

  TaskCommitments TaskCommitment[]

  @@unique([userId])
}

model UserWallet {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  walletAddress String
  stakeAddress  String

  @@unique([userId])
}

// Andamio AI

model AndamioAIQueries {
  id        String   @id @default(cuid())
  userId    String
  type      String
  inputs    String   @db.Text
  outputs   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ClientsDomain -> Premium Feature

model ClientsDomain {
  id       String @id @default(cuid())
  host     String
  courseId String @unique
}

// ---------------- NEW CONTRIBUTION FEATURES - PREPROD ONLY ---------------------------------

model Treasury {
  id                  String  @id @default(cuid())
  treasuryNftPolicyId String? @unique

  title       String
  description String?
  imageUrl    String?
  videoUrl    String?

  live Boolean @default(false)

  treasuryOwner   TreasuryOwner @relation("TreasuryOwnerTreasuries", fields: [treasuryOwnerId], references: [id])
  treasuryOwnerId String

  escrows              Escrow[]              @relation("TreasuryEscrows")
  ContributionManagers ContributionManager[] @relation("ContributionManagerTreasuries")
  Contributor          Contributor?          @relation(fields: [contributorId], references: [id])
  contributorId        String?

  organizations OrganizationTreasury[]

  @@index([id])
  @@index([treasuryNftPolicyId])
  @@index([treasuryOwnerId])
  @@index([contributorId])
}

model Escrow {
  id                  String  @id @default(cuid())
  title               String?
  escrowNftPolicyId   String? @unique
  isSyncedWithNetwork Boolean @default(false)

  savedAcceptanceCriteria String[]

  treasuryId String
  treasury   Treasury @relation("TreasuryEscrows", fields: [treasuryId], references: [id])

  tasks Task[] @relation("EscrowTasks")

  contributorPrerequisites ContributorPrerequisite[] @relation("EscrowPrerequisites")

  @@index([treasuryId])
  @@index([id])
  @@index([escrowNftPolicyId])
}

enum PrerequisiteStatus {
  DRAFT
  PENDING_TX
  ON_CHAIN
}

model ContributorPrerequisite {
  id                  String             @id @default(cuid())
  contributorPolicyId String?            @unique
  title               String?
  status              PrerequisiteStatus @default(DRAFT)

  courseRequirements CourseRequirement[]
  escrows            Escrow[]            @relation("EscrowPrerequisites")

  @@index([contributorPolicyId])
}

model CourseRequirement {
  id              String                  @id @default(cuid())
  prerequisite    ContributorPrerequisite @relation(fields: [prerequisiteId], references: [id])
  prerequisiteId  String
  course          Course                  @relation("PrerequisiteCourses", fields: [courseCode], references: [courseCode])
  courseCode      String
  requiredModules String[]

  @@index([prerequisiteId])
  @@index([courseCode])
}

enum TaskStatus {
  DRAFT
  APPROVED
  PENDING_TX
  ON_CHAIN
  BACKLOG
  ARCHIVED
}

model Token {
  assetId  String  @id @unique
  quantity Int
  Task     Task?   @relation(fields: [taskId], references: [id])
  taskId   String?

  @@index([taskId])
}

model Task {
  id                    String     @id @default(cuid())
  index                 Int
  title                 String
  description           String     @db.Text
  acceptanceCriteria    String[]
  numAllowedCommitments Int        @default(1)
  status                TaskStatus @default(DRAFT)
  arbitraryHash         String?
  taskHash              String?    @unique

  lovelace String
  tokens   Token[]

  expirationTime String

  escrowId String
  escrow   Escrow @relation("EscrowTasks", fields: [escrowId], references: [id])

  taskCommitments TaskCommitment[]

  @@unique([escrowId, index])
  @@index([escrowId])
  @@index([id])
  @@index([title])
  @@index([taskHash])
}

enum TaskCommitmentStatus {
  PENDING_TX_COMMITMENT_MADE
  COMMITMENT_MADE

  PENDING_TX_ADD_INFO
  PENDING_APPROVAL

  PENDING_TX_COMMITMENT_DENIED
  COMMITMENT_DENIED

  PENDING_TX_COMMITMENT_ACCEPTED
  COMMITMENT_ACCEPTED

  PENDING_TX_COMMITMENT_REFUSED
  COMMITMENT_REFUSED

  PENDING_TX_GET_REWARDS
  REWARDS_CLAIMED

  PENDING_TX_UNLOCKED_BY_CONTRIBUTOR
  UNLOCKED_BY_CONTRIBUTOR

  ARCHIVED
}

model TaskCommitment {
  id String @id @default(cuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  contributorId String
  contributor   Contributor @relation(fields: [contributorId], references: [id])

  status TaskCommitmentStatus @default(PENDING_APPROVAL)

  evidence Json?

  created DateTime @default(now())
  updated DateTime @default(now())

  @@unique([taskId, contributorId])
  @@index([taskId])
  @@index([contributorId])
  @@index([id])
}

// ---------------- END OF NEW CONTRIBUTION FEATURES -----------------------------------------

// ---------------- STRIPE INTEGRATIONS ------------------------------------------------------
enum StripeSubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

// where is StripeEvent used?
model StripeEvent {
  id               String   @id @unique
  api_version      String?
  data             Json
  request          Json?
  type             String
  object           String
  account          String?
  created          DateTime
  livemode         Boolean
  pending_webhooks Int
}

model Feature {
  id          String    @id @default(cuid())
  name        String // e.g., "max_contributors" OR "custom_url_allowed"
  value       String // e.g., "10", "50", "unlimited" OR "true", "false"
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id String @id @unique // from Stripe

  name        String
  description String
  image       String

  active Boolean @default(true)

  maxAllowedOrganizations Int     @default(0)
  maxAllowedCourses       Int
  maxAllowedTreasuries    Int
  treasuryDepositLimit    BigInt
  canPublish              Boolean // determines whether the user can publish owned courses and owned treasuries so that are visible on Andamio Network
  transactionFeeDiscount  Int // As percentage, e.g. 10 -> "10% discount on network fees"

  additionalFeatures Feature[]
  prices             Price[]
  subscriptions      Subscription[]
}

model Price {
  id String @id @unique // from Stripe

  active          Boolean //(can the price be used for new subscriptions?)
  description     String?
  unitAmount      BigInt // (e.g. lovelace or cents, not ada or dollars)
  currency        String // Three-letter ISO currency code, lowercase
  type            String // e.g. one_time || recurring - see stripe docs: are there other options?
  interval        String // e.g. day || week || month || year
  intervalCount   Int // number of intervals included in this price
  trialPeriodDays Int     @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  subscriptions Subscription[]

  @@index([productId])
}

model Subscription {
  id String @id @unique // is the subscription ID from Stripe

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  priceId String
  price   Price  @relation(fields: [priceId], references: [id])

  status StripeSubscriptionStatus

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  created DateTime @default(now())
  updated DateTime @default(now())

  @@unique([userId])
  @@index([userId])
  @@index([priceId])
  @@index([productId])
}

// ---------------- END STRIPE INTEGRATIONS --------------------------------------------------

